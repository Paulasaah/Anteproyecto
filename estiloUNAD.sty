% Archivo de estilo para títulos UNAB numerados según la estructura del documento

\usepackage{titlesec}
\usepackage{setspace}

% Fuente Times New Roman
\usepackage{mathptmx}

% Título 1: (chapter) Negrita, centrado, 12pt, doble espacio
\titleformat{\chapter}[block]
  {\normalfont\bfseries\centering\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {\thechapter}
  {0.75em}
  {}
\titlespacing*{\chapter}
  {0pt}{0pt}{18pt} % Inicio de capítulo sin espacio superior adicional

% Título 2: (section) Negrita, 12pt, alineado a la izquierda, numerado, doble espacio
\titleformat{\section}[block]
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {\thesection}{0.75em}{}
\titlespacing*{\section}
  {0pt}{18pt}{12pt}

% Título 3: (subsection) Negrita, 12pt, alineado a la izquierda, numerado, doble espacio
\titleformat{\subsection}[block]
  {\normalfont \bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {\thesubsection}{0.75em}{}
\titlespacing*{\subsection}
  {0pt}{12pt}{6pt}

% Título 4: (subsubsection) Negrita, 12pt, alineado al margen izquierdo y numerado
\titleformat{\subsubsection}[block]
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {\thesubsubsection}{0.75em}{}
\titlespacing*{\subsubsection}
  {0pt}{12pt}{6pt}

% Título 5: (paragraph) Negrita, 12pt, alineado al margen izquierdo
\titleformat{\paragraph}[block]
  {\normalfont \bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {}{0pt}{}
\titlespacing*{\paragraph}
  {0pt}{6pt}{6pt}

% Numerar capítulos, secciones, subsecciones y subsubsecciones.
% La tabla de contenido controla por separado hasta qué nivel se muestran.
\setcounter{secnumdepth}{3}

% Doble espaciado general en el documento
\AtBeginDocument{\doublespacing}

\endinput

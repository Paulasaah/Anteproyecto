% Archivo de estilo para títulos UNAD sin numeración y con formato específico

\usepackage{titlesec}
\usepackage{setspace}

% Fuente Times New Roman
\usepackage{mathptmx}

% Título 1: (chapter) Negrita, centrado, 12pt, doble espacio
\titleformat{\chapter}[block]
  {\normalfont\bfseries\centering\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {} % Sin numeración
  {0pt}
  {}
\titlespacing*{\chapter}
  {0pt}{0pt}{18pt} % Inicio de capítulo sin espacio superior adicional

% Título 2: (section) Negrita, 12pt, alineado izquierda, sin numeración, doble espacio
\titleformat{\section}[block]
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {}{0pt}{}
\titlespacing*{\section}
  {0pt}{18pt}{12pt}

% Título 3: (subsection) Negrita, 12pt, alineado izquierda, sin numeración, doble espacio
\titleformat{\subsection}[block]
  {\normalfont \bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {}{0pt}{}
\titlespacing*{\subsection}
  {0pt}{12pt}{6pt}

% Título 4: (subsubsection) Negrita, 12pt, alineado al margen izquierdo
\titleformat{\subsubsection}[block]
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {}{0pt}{}
\titlespacing*{\subsubsection}
  {0pt}{12pt}{6pt}

% Título 5: (paragraph) Negrita, 12pt, alineado al margen izquierdo
\titleformat{\paragraph}[block]
  {\normalfont \bfseries\fontsize{12pt}{14pt}\selectfont\singlespacing}
  {}{0pt}{}
\titlespacing*{\paragraph}
  {0pt}{6pt}{6pt}

% Quitar numeración de capítulos/secciones/subsecciones
\setcounter{secnumdepth}{0}

% Doble espaciado general en el documento
\AtBeginDocument{\doublespacing}

\endinput
